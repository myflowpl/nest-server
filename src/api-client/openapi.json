  "info": {
    "title": "Mój Projekt w Nest",
    "description": "Przykładowy projekt w Node.js i TypeScript",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "Contact": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Opis proprerty message jest opcjonalny",
            "example": "test value of message"
          },
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "CreateContactDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "example": "Piotr"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "piotr at myflowpl"
          },
          "message": {
            "type": "string",
            "example": "test value of message"
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "HttpExceptionDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "statusCode": {
            "type": "number"
          }
        },
        "required": [
          "message",
          "error",
          "statusCode"
        ]
      },
      "ExceptionResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ]
      },
      "AuthRegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "example": "Piotr"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "piotr@myflow.pl"
          },
          "password": {
            "type": "string",
            "example": "!@#$"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string",
            "enum": [
              "admin",
              "root"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "password",
          "roles"
        ]
      },
      "AuthLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "piotr@myflow.pl"
          },
          "password": {
            "type": "string",
            "example": "!@#$"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthLoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "AddRoleDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "number"
          },
          "roleName": {
            "type": "string",
            "enum": [
              "admin",
              "root"
            ]
          }
        },
        "required": [
          "userId",
          "roleName"
        ]
      }
    }
  }
}