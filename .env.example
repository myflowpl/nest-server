# Skopiuj ten plik jako .env:  cp .env.example .env

# Port serwera NestJS
PORT=3000

# Pokazuj szczegóły błędów w odpowiedziach (tylko na developmencie)
DEBUG=true

# Sekret do podpisywania tokenów JWT (zmień na własny)
JWT_SECRET=mySecret

# Baza PostgreSQL uruchamiana przez docker compose
POSTGRES_USER=nest
POSTGRES_PASSWORD=nest
POSTGRES_DB=nest
# Zmień, jeśli port 5432 jest zajęty (np. przez lokalnie zainstalowany PostgreSQL)
POSTGRES_PORT=5432

# Adres bazy używany przez aplikację i Prismę (musi pasować do wartości powyżej)
DATABASE_URL="postgresql://nest:nest@localhost:5432/nest"
