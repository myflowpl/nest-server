generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile Profile?
}

// relacja 1:1 - każdy użytkownik ma co najwyżej jeden profil
model Profile {
  id          Int     @id @default(autoincrement())
  displayName String
  bio         String?
  userId      Int     @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
