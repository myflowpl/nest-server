{
  "name": "nest-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --entryFile worker/worker.main --watch",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:psql": "docker compose exec db psql -U nest -d nest",
    "db:reset": "prisma migrate reset && prisma db seed",
    "db:playground": "tsx --env-file=.env scripts/playground.ts",
    "db:n-plus-one": "tsx --env-file=.env scripts/n-plus-one.ts",
    "db:race": "tsx --env-file=.env scripts/last-admin-race.ts",
    "check:d1": "node --env-file=.env scripts/check.mjs d1",
    "check:d2": "node --env-file=.env scripts/check.mjs d2",
    "check:d3": "node --env-file=.env scripts/check.mjs d3",
    "check:d4": "node --env-file=.env scripts/check.mjs d4",
    "check:d5": "node --env-file=.env scripts/check.mjs d5",
    "check:d6": "node --env-file=.env scripts/check.mjs d6",
    "check:d7": "node --env-file=.env scripts/check.mjs d7",
    "extra:big-image": "node scripts/big-image.mjs",
    "extra:broken-image": "node scripts/broken-image.mjs",
    "check:e1": "node --env-file=.env scripts/check-extra.mjs e1",
    "check:e2": "node --env-file=.env scripts/check-extra.mjs e2",
    "check:e3": "node --env-file=.env scripts/check-extra.mjs e3",
    "check:e4": "node --env-file=.env scripts/check-extra.mjs e4",
    "check:e5": "node --env-file=.env scripts/check-extra.mjs e5",
    "check:e6": "node --env-file=.env scripts/check-extra.mjs e6",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "^12.3.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.3.3",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/websockets": "^12.3.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "bcrypt": true,
    "prisma": true,
    "@prisma/engines": true,
    "fsevents": true,
    "@scarf/scarf": false
  }
}
