# Skopiuj ten plik jako .env tylko wtedy, gdy chcesz zmienić domyślne wartości.
# Bez pliku .env projekt i baza działają na poniższych ustawieniach.

# Port serwera NestJS
PORT=3000

# Baza PostgreSQL uruchamiana przez docker compose
POSTGRES_USER=nest
POSTGRES_PASSWORD=nest
POSTGRES_DB=nest
# Zmień, jeśli port 5432 jest zajęty (np. przez lokalnie zainstalowany PostgreSQL)
POSTGRES_PORT=5432

DATABASE_URL="postgresql://nest:nest@localhost:5432/nest"
